extends Control

var main: Node = null
var container: VBoxContainer = null

func setup(m: Node) -> void:
	main = m
	var bg := ColorRect.new()
	bg.color = Color(0, 0, 0, 0.8)
	bg.size = Vector2(1152, 648)
	bg.position = Vector2.ZERO
	add_child(bg)

	var panel := Panel.new()
	panel.size = Vector2(420, 240)
	panel.position = Vector2((1152 - 420) / 2.0, (648 - 240) / 2.0)
	add_child(panel)

	container = VBoxContainer.new()
	container.position = Vector2(20, 20)
	container.size = Vector2(380, 200)
	container.add_theme_constant_override("separation", 10)
	panel.add_child(container)

func refresh() -> void:
	for c in container.get_children():
		c.queue_free()

	var title := Label.new()
	title.text = "GAME OVER"
	title.add_theme_font_size_override("font_size", 32)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	container.add_child(title)

	var t: int = int(main.elapsed)
	var info := Label.new()
	info.text = "生存时长: %02d:%02d" % [t / 60, t % 60]
	info.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	container.add_child(info)

	var btn := Button.new()
	btn.text = "重新来过"
	btn.focus_mode = Control.FOCUS_NONE
	btn.pressed.connect(_on_restart)
	container.add_child(btn)

func _input(event: InputEvent) -> void:
	if not visible:
		return
	if event is InputEventKey and event.pressed and not event.echo:
		if (event as InputEventKey).keycode == KEY_R:
			_on_restart()
			get_viewport().set_input_as_handled()

func _on_restart() -> void:
	main.restart()
