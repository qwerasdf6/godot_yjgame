extends Control

@export var player_path: NodePath

func _draw() -> void:
	var enemies := get_tree().get_nodes_in_group("enemies")
	print("enemies count: ", enemies.size())
	#draw_rect(Rect2(100, 100, 200, 200), Color.RED, false, 3.0)
	
	var player := get_node_or_null(player_path)
	if player == null:
		return
	var player_screen := _to_screen(player.global_position)
	
	for enemy in get_tree().get_nodes_in_group("enemies"):
		if not is_instance_valid(enemy) or enemy.dead:
			continue
		
		var rect := _enemy_screen_rect(enemy)
		draw_rect(rect, Color.CYAN, false, 2.0)
		draw_line(rect.get_center(), player_screen, Color.RED, 1.5)

func _to_screen(world_pos: Vector2) -> Vector2:
	# 世界坐标 → 屏幕坐标（受相机影响）
	return get_viewport().get_canvas_transform() * world_pos

func _enemy_screen_rect(enemy: Node2D) -> Rect2:
	var sprite: Sprite2D = enemy.get_node_or_null("Sprite2D")
	if sprite and sprite.texture:
		var size: Vector2 = sprite.texture.get_size() * sprite.scale
		var center := _to_screen(enemy.global_position)
		return Rect2(center - size / 2, size)
	var center := _to_screen(enemy.global_position)
	return Rect2(center - Vector2(16, 16), Vector2(32, 32))
